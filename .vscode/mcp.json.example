{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--isolated"
      ],
      "sandboxEnabled": true
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "${workspaceFolder}"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1"
      ]
    }
  }
}