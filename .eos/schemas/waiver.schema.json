{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/waiver.schema.json",
  "title": "EOS gate waiver",
  "description": "A controlled exception. EOS can draft one (`eos waive`), but a waiver is only honored once a human other than the requester has recorded themselves as approver — and never past its expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "scope", "reason", "riskOwner", "requestedBy", "approver", "expiresOn", "compensatingControls"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gate": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["product", "story", "release"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "reason": { "type": "string", "minLength": 20 },
    "riskOwner": { "type": "string", "minLength": 1 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "approver": { "type": "string" },
    "expiresOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "trigger": { "type": "string" },
    "compensatingControls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
