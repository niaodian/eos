{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/next-action.schema.json",
  "title": "EOS next-best-action contract",
  "description": "The stable JSON contract emitted by `eos next --json` / `eos resume --json` and consumed by eos-guide, the prompts and the VS Code tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repo", "current", "recommendedAction", "alternatives", "blockers", "exitCode"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 20 },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "root"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "root": { "type": "string", "minLength": 1 }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeType", "scopeId", "state"],
      "properties": {
        "scopeType": { "enum": ["product", "story", "release"] },
        "scopeId": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "changeType": { "type": ["string", "null"] }
      }
    },
    "recommendedAction": { "$ref": "#/$defs/action" },
    "alternatives": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "check", "status", "detail"],
        "properties": {
          "gate": { "type": "string" },
          "check": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "PENDING", "WAIVED", "NOT_APPLICABLE", "STALE", "ERROR"] },
          "detail": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "exitCode": { "enum": [0, 1, 2, 3] }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "reason", "command", "doneWhen"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "targetGate": { "type": ["string", "null"] },
        "copilotAgent": { "type": ["string", "null"] },
        "copilotPrompt": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] },
        "skills": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string", "minLength": 1 },
        "doneWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "type": ["string", "null"] }
      }
    }
  }
}
