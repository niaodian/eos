{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/next-action.schema.json",
  "title": "EOS next-best-action contract",
  "description": "The stable JSON contract emitted by `eos next --json` / `eos resume --json` and consumed by eos-guide, the prompts and the VS Code tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "repo",
    "current",
    "recommendedAction",
    "alternatives",
    "blockers",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 20
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "root"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "scopeId",
        "state"
      ],
      "properties": {
        "scopeType": {
          "enum": [
            "product",
            "story",
            "release"
          ]
        },
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recommendedAction": {
      "$ref": "#/$defs/action"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "check",
          "status",
          "detail"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "PENDING",
              "WAIVED",
              "NOT_APPLICABLE",
              "STALE",
              "DEFERRED",
              "ERROR"
            ]
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "track": {
      "type": "object",
      "description": "The governance track the project is on, derived from its declaration (complianceProfile \"regulated\" = Regulated), and what a release on it requires. (ADR-012)",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "summary",
        "releaseRequires"
      ],
      "properties": {
        "name": {
          "enum": [
            "standard",
            "regulated"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "releaseRequires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policyDrift": {
      "type": "object",
      "description": "Present only when the policy differs from .eos/policy.lock.json. `weakenings` lists the changes that still need an acknowledgement (`eos policy lock --write --reason`) and a second person's approval.",
      "additionalProperties": false,
      "required": [
        "lockDigest",
        "currentDigest",
        "weakenings",
        "otherChanges"
      ],
      "properties": {
        "lockDigest": {
          "type": "string",
          "minLength": 64
        },
        "currentDigest": {
          "type": "string",
          "minLength": 64
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "weakenings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "otherChanges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "crossBranch": {
      "type": "object",
      "description": "Present only when the base branch has moved a story or release this branch is also working on, since the branch left it. Compared with LOCAL refs only; EOS never fetches.",
      "required": [
        "base",
        "overlaps"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "overlaps": {
          "type": "array"
        }
      }
    },
    "activation": {
      "type": "object",
      "description": "Present only when the project has declared itself but docs/eos/activation.md still has unchecked hardening items (eos-2.6.0): nothing enforces the gates yet, and /eos-init is where that is done.",
      "required": [
        "pending",
        "command"
      ],
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "string"
        }
      }
    },
    "oneWayDoors": {
      "type": "object",
      "description": "Present only when an ADR for an irreversible decision is still \"proposed\" (eos-2.6.0): a person confirms it before release-ready passes.",
      "required": [
        "proposed"
      ],
      "properties": {
        "proposed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nfrScale": {
      "type": "array",
      "description": "Present only before the first story is built, when an NFR is stated at a scale (eos-2.6.0): the dataset to measure it on belongs in the first story that touches it.",
      "items": {
        "type": "string"
      }
    },
    "releasePreview": {
      "type": "object",
      "description": "Present only when the release gate (G8) will need something that does not exist yet (eos-2.2.0): a declared dependency audit, NFR measurements, a runbook, a deployment-topology ADR, and on the Regulated track a release signing key. A preview from declarations and file presence — G8 still decides.",
      "additionalProperties": false,
      "required": [
        "gate",
        "code",
        "items"
      ],
      "properties": {
        "gate": {
          "const": "release-ready"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "ready",
              "what",
              "detail"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "ready": {
                "type": "boolean"
              },
              "what": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reason",
        "command",
        "doneWhen"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "targetGate": {
          "type": [
            "string",
            "null"
          ]
        },
        "copilotAgent": {
          "type": [
            "string",
            "null"
          ]
        },
        "copilotPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "doneWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
