{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/gate-definition.schema.json",
  "title": "EOS gate registry",
  "description": "The machine-verified gates. `version` participates in evidence staleness: bumping it invalidates every previous PASS for that gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "scope", "version", "title", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "code": { "type": "string", "pattern": "^G[0-9A-Z-]+$" },
          "scope": { "enum": ["product", "story", "release"] },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "waivable": { "type": "boolean" },
          "bindsProductTree": {
            "description": "This gate asserts something about the PRODUCT (not just about a document), so its evidence records the identity of the tree it ran against and expires when that tree changes.",
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "evaluator"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string", "minLength": 1 },
                "evaluator": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
                "fix": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
