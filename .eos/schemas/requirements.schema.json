{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/requirements.schema.json",
  "title": "EOS requirements record (G2)",
  "description": "The structured half of docs/requirements.md, including the operational pre-flight. Every pre-flight concern is ADOPT, SKIP + reason, or DEFER + owner + trigger — there is no empty cell and there is no bare 'SKIP'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "functional", "nfr", "operationalPreFlight"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "functional": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^FR\\d+$" },
          "statement": { "type": "string", "minLength": 15 },
          "priority": { "enum": ["MUST", "SHOULD", "COULD", "WONT"] }
        }
      }
    },
    "nfr": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^NFR\\d+$" },
          "category": { "enum": ["performance", "availability", "scalability", "security", "cost", "accessibility", "operability", "other"] },
          "statement": { "type": "string", "minLength": 10 },
          "target": { "type": "string" }
        }
      }
    },
    "operationalPreFlight": {
      "description": "The 1-N operational concerns decided BEFORE build, not retrofitted after launch. Keys are fixed so a missing decision is detectable; `compliance` is required only for a regulated product.",
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetry", "authz", "audit", "rollback", "monitoring", "canary", "quota", "i18n", "multiTenancy", "capacitySlo", "dr"],
      "properties": {
        "telemetry": { "$ref": "#/$defs/decision" },
        "authz": { "$ref": "#/$defs/decision" },
        "audit": { "$ref": "#/$defs/decision" },
        "rollback": { "$ref": "#/$defs/decision" },
        "monitoring": { "$ref": "#/$defs/decision" },
        "canary": { "$ref": "#/$defs/decision" },
        "quota": { "$ref": "#/$defs/decision" },
        "i18n": { "$ref": "#/$defs/decision" },
        "multiTenancy": { "$ref": "#/$defs/decision" },
        "capacitySlo": { "$ref": "#/$defs/decision" },
        "dr": { "$ref": "#/$defs/decision" },
        "compliance": { "$ref": "#/$defs/decision" }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "status"],
        "properties": {
          "question": { "type": "string", "minLength": 5 },
          "status": { "enum": ["OPEN", "RESOLVED"] },
          "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR"] },
          "resolution": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["ADOPT", "SKIP", "DEFER"] },
        "note": { "description": "Required for ADOPT: what will be built.", "type": "string" },
        "reason": { "description": "Required for SKIP: why this product genuinely does not need it.", "type": "string" },
        "owner": { "description": "Required for DEFER: the person who owns the gap.", "type": "string" },
        "trigger": { "description": "Required for DEFER: the condition that ends the deferral.", "type": "string" },
        "dueBy": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
