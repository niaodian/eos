{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/nfr-summary.schema.json",
  "title": "EOS machine NFR summary",
  "description": "Measured non-functional results for the release gate. A target written in a checklist is an intention; this file is the measurement. Every target is ADOPT (measured), SKIP (with a reason) or DEFER (with an owner and a trigger) — there is no empty cell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 20
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "description": "WHO produced this evidence. A summary written by hand and one emitted by a verified CI run are both JSON; only this field distinguishes them. `local` is honest and usable for development — a project policy may still refuse to RELEASE on it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "local",
            "ci"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runRef": {
          "description": "CI run id / URL, when type is ci.",
          "type": "string"
        }
      }
    },
    "commandDigest": {
      "description": "SHA-256 of the exact command line that produced this. Binds the result to how it was obtained, so swapping `npm test` for `true` is visible.",
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "toolchainDigest": {
      "description": "SHA-256 over the resolved toolchain identity (runtime + versions). Optional; when present a toolchain change invalidates the result.",
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "attestation": {
      "description": "Provenance from an external authority. EOS Core defines the shape and verifies nothing itself: `none` is the honest default, and a provider adapter (github/sigstore/slsa) is what turns a reference into a verified fact. An unavailable provider is BLOCKED, never PASS.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "github",
            "sigstore",
            "slsa"
          ]
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "productTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 32
        },
        "algorithm": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "performance",
              "availability",
              "scalability",
              "security",
              "cost",
              "accessibility",
              "other"
            ]
          },
          "decision": {
            "enum": [
              "ADOPT",
              "SKIP",
              "DEFER"
            ]
          },
          "metric": {
            "type": "string"
          },
          "comparator": {
            "enum": [
              ">=",
              ">",
              "<=",
              "<",
              "=="
            ]
          },
          "threshold": {
            "type": "number"
          },
          "observed": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 5
          },
          "dueBy": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidenceRef": {
            "type": "string"
          }
        }
      }
    }
  }
}
