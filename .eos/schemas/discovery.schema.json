{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/discovery.schema.json",
  "title": "EOS discovery record (G1)",
  "description": "The structured half of docs/discovery.md. A gate that only checks 'the file exists' passes an empty file, so the falsifiable problem, the measurable metric and the scope boundary are recorded here where a machine can read them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "problem", "successMetric", "scope"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "falsifiableBy"],
      "properties": {
        "statement": { "type": "string", "minLength": 25 },
        "falsifiableBy": {
          "description": "The observation that would prove this problem statement WRONG. A statement nothing could falsify is a slogan.",
          "type": "string",
          "minLength": 20
        },
        "affectedUsers": { "type": "string" }
      }
    },
    "successMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "dataSource"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "baseline": { "type": ["number", "string"] },
        "target": { "type": ["number", "string"], "minLength": 1 },
        "unit": { "type": "string" },
        "dataSource": {
          "description": "Where the number will actually come from. Without it the metric cannot be measured, only quoted.",
          "type": "string",
          "minLength": 5
        },
        "measuredBy": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "out": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "status"],
        "properties": {
          "question": { "type": "string", "minLength": 5 },
          "status": { "enum": ["OPEN", "RESOLVED"] },
          "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR"] },
          "resolution": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
