{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.github/hooks/deny-dangerous.js\" --format claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
