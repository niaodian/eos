{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .github/hooks/deny-dangerous.js --format claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}