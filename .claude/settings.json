{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.github/hooks/deny-dangerous.js",
              "--format",
              "claude"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
