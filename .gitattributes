# EOS is a local-first, cross-platform template. Force LF everywhere so hooks, shell
# scripts, and configs behave identically on macOS, Linux, and native Windows — a CRLF
# checkout breaks `*.sh` shebang parsing and can skew line-based hook/regex logic.
# The repo is authored all-LF; this keeps it that way regardless of a contributor's
# `core.autocrlf` setting. Binary types below are never line-ending-normalized.

# Text: normalize to LF in the repo AND on checkout (every OS).
* text=auto eol=lf

# Operational scripts that MUST stay LF (belt-and-suspenders over the rule above).
*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf

# Binary assets — leave bytes untouched (future-proofing; none tracked yet).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary

# The append-only ledger must NEVER be auto-merged. A textual merge of two appended tails produces
# duplicated sequence numbers and prevHash pointers that lead nowhere — a chain that `ledger
# --verify` correctly rejects, after git has already "succeeded". `-merge` forces a conflict
# instead, and `eos ledger --resolve` replays both sides into one valid chain keeping every event.
.eos/ledger/events.jsonl -merge
.eos/ledger/head.json    -merge
