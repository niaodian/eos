# EOS .env.example — COMMIT THIS (placeholders only), never the real .env.
# Copy to .env and fill locally. .env is gitignored; .env.example is the shared contract.
# Rule: secrets live only in env / a secret store — never in code, logs, fixtures, or the frontend bundle.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (never commit real values) ---
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>

# --- LLM / AI provider (server-side only; never expose to the browser) ---
# Do NOT prefix with NEXT_PUBLIC_ / VITE_ — that would ship the key to the client bundle.
OPENAI_API_KEY=<your-key>
LLM_MODEL=<pinned-model-id>

# --- Auth / signing ---
JWT_SECRET=<random-32-bytes>

# --- Public, browser-safe values ONLY (safe to expose) ---
# NEXT_PUBLIC_APP_NAME=EOS App
