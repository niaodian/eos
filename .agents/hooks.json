{
  "eos-guardrail": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/hooks/deny-dangerous.js\" --format antigravity",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
