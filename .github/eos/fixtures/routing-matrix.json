{
  "note": "Table-driven routing matrix. Each case builds a throwaway repository, optionally applies ledger transitions, then asserts the deterministic recommendation produced by the CLI (the consumer path, not just the router function).",
  "cases": [
    {
      "name": "brand new repository — nothing is declared yet",
      "governance": false,
      "files": { "README.md": "# app\n" },
      "expectedAction": "complete-local-activation",
      "expectedPrompt": "eos-init",
      "expectedExitCode": 2,
      "expectBlocker": "activation"
    },
    {
      "name": "untouched template declaration while product code exists",
      "files": {
        "@project": { "projectType": "config-only", "stacks": [], "productParadigms": ["deterministic"] },
        "package.json": "{ \"name\": \"app\", \"scripts\": { \"test\": \"node --version\" } }\n"
      },
      "expectedAction": "complete-local-activation",
      "expectedExitCode": 2,
      "expectBlocker": "declaration-matches-repo"
    },
    {
      "name": "activated, no discovery yet",
      "files": { "@project": "@APP" },
      "expectedAction": "frame-the-problem",
      "expectedAgent": "eos-discovery",
      "expectedExitCode": 2
    },
    {
      "name": "discovery done, requirements missing",
      "files": { "@project": "@APP", "docs/discovery.md": "# Discovery\n\nProblem: users cannot log in.\n" },
      "expectedAction": "expand-requirements",
      "expectedPrompt": "requirements",
      "expectedExitCode": 2
    },
    {
      "name": "requirements done, PRD missing",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n"
      },
      "expectedAction": "write-prd",
      "expectedPrompt": "spec",
      "expectedExitCode": 2
    },
    {
      "name": "PRD exists but has duplicate acceptance-criterion ids",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n",
        "docs/prd.md": "# PRD\n\n- AC1.1 log in\n- AC1.1 log in again\n"
      },
      "expectedAction": "repair-prd",
      "expectedExitCode": 2,
      "expectBlocker": "ac-unique"
    },
    {
      "name": "PRD exists but still carries an unresolved BLOCKER",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n",
        "docs/prd.md": "# PRD\n\n- AC1.1 log in\n- BLOCKER: pricing model undecided\n"
      },
      "expectedAction": "repair-prd",
      "expectedExitCode": 2,
      "expectBlocker": "no-open-blockers"
    },
    {
      "name": "PRD ready, UX contract missing",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n",
        "docs/prd.md": "@PRD"
      },
      "expectedAction": "design-ux",
      "expectedAgent": "eos-design",
      "expectedExitCode": 2
    },
    {
      "name": "UX explicitly skipped for a backend service, architecture missing",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n",
        "docs/prd.md": "@PRD",
        "docs/EXPERIENCE.md": "# Experience\n\nSKIP — no user-facing surface (internal API only).\n"
      },
      "expectedAction": "design-architecture",
      "expectedAgent": "eos-architecture",
      "expectedExitCode": 2
    },
    {
      "name": "architecture approved, no stories yet",
      "files": {
        "@project": "@APP",
        "docs/discovery.md": "# Discovery\n",
        "docs/requirements.md": "# Requirements\n",
        "docs/prd.md": "@PRD",
        "docs/EXPERIENCE.md": "SKIP — no user-facing surface (internal API only).\n",
        "docs/architecture.md": "# Architecture\n"
      },
      "expectedAction": "plan-stories",
      "expectedAgent": "eos-plan",
      "expectedExitCode": 2
    },
    {
      "name": "story exists but an acceptance criterion has no test intent",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-012.md": { "_story": { "id": "STORY-012", "rows": [["AC1.1", "user can log in", "tests/login.test.mjs::valid", "—"], ["AC1.2", "user can log out", "—", "—"]] } }
      },
      "expectedAction": "design-acceptance-tests",
      "expectedAgent": "eos-plan",
      "expectedSkill": "bmad-testarch-atdd",
      "expectedExitCode": 2,
      "expectBlocker": "ac-test-intent"
    },
    {
      "name": "agentic story with no eval case for an acceptance criterion",
      "files": {
        "@project": { "projectType": "application", "stacks": ["node"], "productParadigms": ["agentic"], "commands": { "test": "node --version", "eval": "node --version" } },
        "docs/prd.md": "@PRD",
        "docs/eval-plan.md": "# Eval plan\n",
        "docs/stories/STORY-020.md": { "_story": { "id": "STORY-020", "rows": [["AC1.1", "assistant answers", "tests/a.test.mjs::x", "—"]] } }
      },
      "expectedAction": "design-eval-cases",
      "expectedPrompt": "eval-spec",
      "expectedExitCode": 2,
      "expectBlocker": "agentic-eval-case"
    },
    {
      "name": "story missing telemetry / authorization / rollback tasks",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-030.md": { "_story": { "id": "STORY-030", "ops": false } }
      },
      "expectedAction": "complete-story-readiness",
      "expectedAgent": "eos-plan",
      "expectedExitCode": 2,
      "expectBlocker": "ops-tasks"
    },
    {
      "name": "story references an acceptance criterion that is not in the PRD",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-040.md": { "_story": { "id": "STORY-040", "rows": [["AC9.9", "invented criterion", "tests/x.test.mjs::y", "—"]] } }
      },
      "expectedAction": "complete-story-readiness",
      "expectedExitCode": 2,
      "expectBlocker": "ac-references-resolve"
    },
    {
      "name": "story claims a state the ledger never granted",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-050.md": { "_story": { "id": "STORY-050", "state": "VERIFIED" } }
      },
      "expectedAction": "complete-story-readiness",
      "expectedExitCode": 2,
      "expectBlocker": "state-not-hand-edited"
    },
    {
      "name": "story is ready — the next step is the guarded promotion, not more writing",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-060.md": { "_story": { "id": "STORY-060" } }
      },
      "transitions": [["story", "STORY-060", "IN_REVIEW"]],
      "expectedAction": "promote-story",
      "expectedExitCode": 0
    },
    {
      "name": "story is READY_FOR_DEV — implement it",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-070.md": { "_story": { "id": "STORY-070" } }
      },
      "checks": [["story-ready", "STORY-070"]],
      "transitions": [["story", "STORY-070", "IN_REVIEW"], ["story", "STORY-070", "READY_FOR_DEV"]],
      "expectedAction": "implement-story",
      "expectedSkill": "bmad-dev-story",
      "expectedExitCode": 0
    },
    {
      "name": "story is IN_DEVELOPMENT — verify it",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-080.md": { "_story": { "id": "STORY-080" } }
      },
      "checks": [["story-ready", "STORY-080"]],
      "transitions": [["story", "STORY-080", "IN_REVIEW"], ["story", "STORY-080", "READY_FOR_DEV"], ["story", "STORY-080", "IN_DEVELOPMENT"]],
      "expectedAction": "verify-story",
      "expectedExitCode": 0
    },
    {
      "name": "story is READY_FOR_TEST but there is no trace matrix",
      "hooks": true,
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-090.md": { "_story": { "id": "STORY-090" } }
      },
      "checks": [["story-ready", "STORY-090"]],
      "transitions": [["story", "STORY-090", "IN_REVIEW"], ["story", "STORY-090", "READY_FOR_DEV"], ["story", "STORY-090", "IN_DEVELOPMENT"], ["story", "STORY-090", "READY_FOR_TEST"]],
      "expectedAction": "build-trace-matrix",
      "expectedExitCode": 2,
      "expectBlocker": "trace-complete"
    },
    {
      "name": "story is READY_FOR_TEST and the product test command is missing its toolchain — BLOCKED, never PASS",
      "hooks": true,
      "files": {
        "@project": { "projectType": "application", "stacks": ["node"], "productParadigms": ["deterministic"], "commands": { "test": "definitely-not-installed-eos" } },
        "docs/prd.md": "@PRD",
        "docs/trace-matrix.md": "| AC | Test | Result |\n| --- | --- | --- |\n| AC1.1 | login.test.mjs | ✅ |\n",
        "docs/stories/STORY-100.md": { "_story": { "id": "STORY-100" } }
      },
      "checks": [["story-ready", "STORY-100"], ["verified", "STORY-100"]],
      "transitions": [["story", "STORY-100", "IN_REVIEW"], ["story", "STORY-100", "READY_FOR_DEV"], ["story", "STORY-100", "IN_DEVELOPMENT"], ["story", "STORY-100", "READY_FOR_TEST"]],
      "expectedAction": "repair-verification",
      "expectedExitCode": 2,
      "expectBlocker": "tests-executed"
    },
    {
      "name": "a documentation-only change has no applicable gate",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-110.md": { "_story": { "id": "STORY-110", "changeType": "DOC_ONLY" } }
      },
      "expectedAction": "start-next-change",
      "expectedExitCode": 0
    },
    {
      "name": "a spike is unguarded but must end in a decision record",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/SPIKE-001.md": { "_story": { "id": "SPIKE-001", "changeType": "SPIKE" } }
      },
      "expectedAction": "record-spike-outcome",
      "expectedPrompt": "adr",
      "expectedExitCode": 0
    },
    {
      "name": "a bugfix does not re-require the PRD gate but still needs story readiness",
      "files": {
        "@project": "@APP",
        "docs/stories/BUG-001.md": { "_story": { "id": "BUG-001", "changeType": "BUGFIX", "rows": [["AC1.1", "login stops rejecting valid passwords", "—", "—"]] } }
      },
      "expectedAction": "design-acceptance-tests",
      "expectedExitCode": 2,
      "expectBlocker": "ac-test-intent"
    },
    {
      "name": "a hotfix with an approved, unexpired waiver may proceed",
      "files": {
        "@project": "@APP",
        "docs/stories/HOT-001.md": { "_story": { "id": "HOT-001", "changeType": "HOTFIX", "rows": [["AC1.1", "restore checkout", "—", "—"]] } },
        ".eos/waivers/hot-001.json": {
          "schemaVersion": 1,
          "gate": "story-ready",
          "scope": { "type": "story", "id": "HOT-001" },
          "reason": "Checkout is down in production; the readiness review is deferred by 24 hours.",
          "riskOwner": "ops-lead",
          "requestedBy": "dev-a",
          "approver": "cto",
          "expiresOn": "2999-01-01",
          "compensatingControls": ["staging smoke test", "follow-up story within 3 days"]
        }
      },
      "expectedAction": "promote-story",
      "expectedExitCode": 0
    },
    {
      "name": "a hotfix whose waiver has expired is blocked again",
      "files": {
        "@project": "@APP",
        "docs/stories/HOT-002.md": { "_story": { "id": "HOT-002", "changeType": "HOTFIX", "rows": [["AC1.1", "restore checkout", "—", "—"]] } },
        ".eos/waivers/hot-002.json": {
          "schemaVersion": 1,
          "gate": "story-ready",
          "scope": { "type": "story", "id": "HOT-002" },
          "reason": "Checkout is down in production; the readiness review is deferred by 24 hours.",
          "riskOwner": "ops-lead",
          "requestedBy": "dev-a",
          "approver": "cto",
          "expiresOn": "2000-01-01",
          "compensatingControls": ["staging smoke test"]
        }
      },
      "expectedAction": "design-acceptance-tests",
      "expectedExitCode": 2
    },
    {
      "name": "release candidate with unverified stories is blocked",
      "hooks": true,
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        "docs/stories/STORY-120.md": { "_story": { "id": "STORY-120" } },
        ".eos/local/active-work.json": { "schemaVersion": 1, "scopeType": "release", "scopeId": "v0.2.0", "changeType": "RELEASE" }
      },
      "expectedAction": "repair-release",
      "expectedPrompt": "release-gate",
      "expectedExitCode": 2,
      "expectBlocker": "stories-verified"
    },
    {
      "name": "a broken agent map blocks the recommendation instead of proposing an unusable agent",
      "files": {
        "@project": "@APP",
        "docs/prd.md": "@PRD",
        ".eos/agent-map.json": { "schemaVersion": 1, "actions": { "frame-the-problem": { "agent": "does-not-exist", "skills": [] } } },
        "docs/stories/STORY-130.md": { "_story": { "id": "STORY-130", "rows": [["AC1.1", "user can log in", "—", "—"]] } }
      },
      "expectedAction": "design-acceptance-tests",
      "expectedExitCode": 2,
      "expectBlocker": "agent-map"
    },
    {
      "name": "an unparseable workflow file is an ERROR, and the recommendation is to fix EOS itself",
      "files": { "@project": "@APP", ".eos/workflow.json": "{ broken" },
      "expectedAction": "fix-eos-configuration",
      "expectedExitCode": 3
    }
  ]
}
