node_modules/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.npmrc
credentials.json
secrets.*
*.secret
dist/
build/
.DS_Store

# compiled Java class files (compliance-starter is source-only; compile out-of-tree)
*.class

# Python bytecode cache (compliance-starter Python port)
__pycache__/
*.pyc
.pytest_cache/

# generated docs (rebuild via docs/eos/tools/build-pdf.sh)
docs/eos/*.pdf
docs/eos/.user-manual.html

# VS Code: keep local editor settings out, but COMMIT the shared MCP server config.
# VS Code docs recommend committing .vscode/mcp.json for team sharing. A global `.vscode/`
# ignore excludes the whole dir, so we must re-include the dir before re-including the file.
!.vscode/
.vscode/*
!.vscode/mcp.json
